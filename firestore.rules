rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /profiles/{profileId} {
      allow read: if profileId == 'public';
      allow write: if profileId == 'public' && isAdmin();
    }

    match /repositories/{repositoryId} {
      allow read: if isAdmin() || resource.data.isPublic == true;
      allow write: if isAdmin();
    }

    match /skills/{skillId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if resource.data.isPublic == true || isAdmin();
      allow write: if isAdmin();
    }

    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'email', 'subject', 'message', 'read', 'createdOn'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 160
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 5000
        && request.resource.data.read == false
        && request.resource.data.createdOn == request.time;
      allow read, update, delete: if isAdmin();
    }

    match /admin_activity/{activityId} {
      allow read, write: if isAdmin();
    }

    match /site_meta/{metaId} {
      allow read: if metaId == 'content' || metaId == 'appearance' || isAdmin();
      allow write: if isAdmin();
    }
  }
}
